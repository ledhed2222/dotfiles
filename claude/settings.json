{
  "editorMode": "vim",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/tmux-flag-attention.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/tmux-clear-attention.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/tmux-clear-attention.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/tmux-flag-on-stop.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "skill-creator@claude-plugins-official": true,
    "rememberthemilk@ledhed2222": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ledhed2222": {
      "source": {
        "source": "github",
        "repo": "ledhed2222/claude-plugins"
      }
    }
  },
  "tui": "default",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(cat *mise.local.toml*)",
      "Bash(gh auth token*)",
      "Bash(grep *mise.local.toml*)",
      "Bash(head *mise.local.toml*)",
      "Bash(less *mise.local.toml*)",
      "Bash(mise env*)",
      "Bash(sed *mise.local.toml*)",
      "Bash(tail *mise.local.toml*)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/mise.local.toml)",
      "Edit(~/**/.env)",
      "Edit(~/**/.env.*.local)",
      "Edit(~/**/.env.development)",
      "Edit(~/**/.env.local)",
      "Edit(~/**/.env.production)",
      "Edit(~/**/.env.test)",
      "Edit(~/**/mise.local.toml)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/mise.local.toml)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*.local)",
      "Read(~/**/.env.development)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.production)",
      "Read(~/**/.env.test)",
      "Read(~/**/mise.local.toml)",
      "Write(**/.env)",
      "Write(**/.env.*.local)",
      "Write(**/.env.development)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.test)",
      "Write(**/mise.local.toml)",
      "Write(~/**/.env)",
      "Write(~/**/.env.*.local)",
      "Write(~/**/.env.development)",
      "Write(~/**/.env.local)",
      "Write(~/**/.env.production)",
      "Write(~/**/.env.test)",
      "Write(~/**/mise.local.toml)"
    ]
  }
}
