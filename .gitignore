.DS_Store

# ~/.config/<dir> symlinks into config/<dir> for each tracked dir (make.sh),
# so these are what their own tools still write inside a tracked dir
config/tmux/plugins/
config/tmux/install_plugins.log

# custom tmuxinator layouts per machine that are not checked in unless they
# are alllowed here
config/tmuxinator/*
!config/tmuxinator/default.yml

# disallow lein repl history
lein/repl-history

# only check in specific claude config files
claude/*
!claude/CLAUDE.md
!claude/settings.json
!claude/keybindings.json
!claude/skills
claude/skills/**/__pycache__/
claude/skills/**/.ruff_cache/

/.ignore
